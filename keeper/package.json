{
  "name": "keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"css/**/*.css\" --max-warnings 0",
    "lint:html": "html-validate index.html",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-include='js/sim.js' --test-coverage-include='js/physics.js' --test-coverage-include='js/morse.js' tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
